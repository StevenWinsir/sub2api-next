    "typecheck": "pnpm run gen:legal && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs"
